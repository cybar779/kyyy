# Firebase Admin SDK (dari file service-account JSON yang lu download di
# Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=injectorapoy
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@injectorapoy.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://injectorapoy-default-rtdb.firebaseio.com

# String acak panjang buat sign JWT session. Generate baru, jangan pakai contoh ini.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
